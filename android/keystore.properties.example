# 이 파일을 같은 폴더에 keystore.properties 로 복사한 뒤 비밀번호를 채운다.
#
#   android/keystore.properties.example  →  android/keystore.properties
#
# keystore.properties 와 *.jks 는 .gitignore 로 막혀 있다.
# 저장소에 올라가면 누구나 이 앱 이름으로 앱을 낼 수 있으니 절대 커밋하지 말 것.
#
# 키는 왁뿌볼·끝말잇기와 같은 것을 쓴다 (계정 하나에 앱 여럿이면 키도 하나).
# 원본: C:\workAndroid\WordChain\wordchain.jks

storeFile=upload.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=여기에_별칭
keyPassword=여기에_키_비밀번호
